eight: 100%;\r\n  font-family: Inter, \"Segoe UI\", Arial, sans-serif;\r\n  background:\r\n    radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 24%),\r\n    radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.05), transparent 22%),\r\n    var(--bg);\r\n  color: var(--text);\r\n}\r\n\r\nbody {\r\n  color: var(--text);\r\n}\r\n\r\na {\r\n  color: inherit;\r\n  text-decoration: none;\r\n}\r\n\r\nbutton,\r\ninput,\r\nselect,\r\ntextarea {\r\n  font: inherit;\r\n}\r\n\r\nbutton {\r\n  border: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.app-shell {\r\n  min-height: 100vh;\r\n  background: transparent;\r\n}\r\n\r\n/* ========================================\r\n   shell.css\r\n   ======================================== */\r\n\r\n/* =========================\r\n   LAYOUT\r\n   ========================= */\r\n\r\n.workspace-shell {\n  min-height: 100vh;\n  display: grid;\n  grid-template-columns: minmax(276px, 308px) minmax(0, 1fr);\n  align-items: start;\n}\n\n.workspace-main {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\r\n}\r\n\r\n.page-shell {\r\n  max-width: var(--container);\r\n  width: 100%;\r\n  margin: 0 auto;\r\n  padding: 28px;\r\n}\r\n\r\n.page-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 24px;\r\n}\r\n\r\n/* =========================\r\n   SIDEBAR\r\n   ========================= */\r\n\r\n.sidebar-shell {\n  position: sticky;\n  top: 0;\n  height: 100vh;\n  padding: 20px 18px;\n  background:\n    linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0)),\n    linear-gradient(180deg, var(--sidebar), var(--sidebar-soft));\n  border-right: 1px solid rgba(255, 255, 255, 0.04);\n  display: flex;\n  flex-direction: column;\n  gap: 26px;\n  overflow-y: auto;\n  box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.03);\n}\n\n.sidebar-brand {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 10px 10px 14px;\n}\n\n.sidebar-brand-main 