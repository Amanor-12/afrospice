\r\n.panel-subtitle {\r\n  margin: 6px 0 0;\r\n  color: var(--muted);\r\n  font-size: 13px;\r\n  line-height: 1.6;\r\n}\r\n\r\n/* =========================\r\n   KPI\r\n   ========================= */\r\n\r\n.simple-kpi-grid,\r\n.stats-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n\r\n.simple-kpi-card,\r\n.stat-card {\r\n  padding: 22px;\r\n  min-height: 132px;\r\n  background:\r\n    linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0.94)),\r\n    var(--card);\r\n}\r\n\r\n.app-shell.dark .simple-kpi-card,\r\n.app-shell.dark .stat-card {\r\n  background:\r\n    linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0)),\r\n    var(--card);\r\n}\r\n\r\n.simple-kpi-card span,\r\n.stat-label {\r\n  display: block;\r\n  color: var(--muted);\r\n  font-size: 12px;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.simple-kpi-card strong,\r\n.stat-value {\r\n  display: block;\r\n  font-size: 31px;\r\n  line-height: 1;\r\n  letter-spacing: -0.04em;\r\n}\r\n\r\n.stat-foot {\r\n  display: block;\r\n  margin-top: 12px;\r\n  color: var(--muted);\r\n  font-size: 12px;\r\n  line-height: 1.6;\r\n}\r\n\r\n/* =========================\r\n   LAYOUTS\r\n   ========================= */\r\n\r\n/* =========================\n   CHART WRAPS\n   ========================= */\n\r\n.chart-wrap,\r\n.clean-chart,\r\n.inventory-chart-clean,\r\n.orders-main-chart-wrap,\r\n.orders-side-chart-wrap,\r\n.reports-main-chart-wrap,\r\n.reports-side-chart-wrap,\r\n.reports-tall-chart,\r\n.dashboard-main-chart-clean,\r\n.dashboard-side-chart-clean {\r\n  border: 1px solid var(--border);\r\n  border-radius: 22px;\r\n  background:\r\n    linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.94)),\r\n    var(--card-soft);\r\n  padding: 14px;\r\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);\r\n}\r\n\r\n.app-shell.dark .chart-wrap,\r\n.app-shell.dark .clean-chart,\r\n.app-shell.dark .inventory-chart-