ackground: rgba(96, 165, 250, 0.18);\n  color: #fff;\n}\n\n.sidebar-footer {\n  margin-top: auto;\n}\n\n.sidebar-store-card {\n  display: grid;\n  gap: 4px;\n  padding: 16px;\n  border-radius: 18px;\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.07);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);\n  color: #fff;\r\n}\r\n\r\n.sidebar-store-card span,\r\n.sidebar-store-card small {\r\n  display: block;\r\n  color: rgba(255, 255, 255, 0.64);\r\n}\r\n\r\n.sidebar-store-card span {\r\n  font-size: 12px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.sidebar-store-card strong {\r\n  display: block;\r\n  font-size: 16px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n/* =========================\r\n   TOPBAR\r\n   ========================= */\r\n\r\n.workspace-topbar {\n  position: sticky;\n  top: 0;\n  z-index: 20;\n  display: flex;\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 16px;\r\n  padding: 20px 28px;\r\n  border-bottom: 1px solid var(--border);\r\n  background: rgba(255, 255, 255, 0.7);\r\n  backdrop-filter: blur(18px);\n}\n\n.app-shell.dark .workspace-topbar {\n  background: rgba(9, 17, 29, 0.72);\n}\n\n.workspace-topbar-leading {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.workspace-overline {\n  margin: 0 0 6px;\n  font-size: 11px;\n  font-weight: 800;\n  color: var(--primary);\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.workspace-heading {\r\n  margin: 0;\r\n  font-size: 22px;\r\n  font-weight: 800;\r\n  letter-spacing: -0.03em;\r\n}\r\n\r\n/* =========================\r\n   OWNER MENU\r\n   ========================= */\r\n\r\n.owner-menu {\r\n  position: relative;\r\n}\r\n\r\n.owner-avatar-btn {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 6px 10px 6px 6px;\n  border-radius: 18px;\n  border: 1px solid var(--border);\n  background: var(--card);\n  box-shadow: var(--shadow-sm);\n  color: var(--text);\n  min-width: 138px;\n}\r\n\r\n.owner-avatar-circle,\r\n.owner-menu-avatar {\r\n  width: 38px;\r\n  height: 38px;\r\n  border-radius: 999px;\r\n  display: grid;\r\n  place-items: center;\r\n  background: linear-gradient(135deg, rgba(37, 99, 235, 0.14), rgba(6, 182, 212, 0.1));\r\n  color: var(--primary);\r\n  font-weight: 800;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.owner-avatar-meta {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n}\r\n\r\n.owner-avatar-meta strong {\r\n  font-size: 13px;\r\n  line-height: 1.1;\r\n}\r\n\r\n.owner-avatar-meta small {\r\n  color: var(--muted);\r\n  font-size: 11px;\r\n  margin-top: 2px;\r\n}\r\n\r\n.owner-menu-dropdown {\r\n  position: absolute;\r\n  top: calc(100% + 10px);\r\n  right: 0;\r\n  width: 260px;\r\n  border-radius: 18px;\r\n  border: 1px solid var(--border-strong);\r\n  background: var(--card);\r\n  box-shadow: var(--shadow-lg);\r\n  padding: 12px;\r\n}\r\n\r\n.owner-menu-header {\r\n  display: grid;\r\n  grid-template-columns: 42px 1fr;\r\n  gap: 12px;\r\n  align-items: center;\r\n  padding: 8px 8px 14px;\r\n  border-bottom: 1px solid var(--border);\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.owner-menu-header strong {\r\n  display: block;\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.owner-menu-header p {\r\n  margin: 0;\r\n  color: var(--muted);\r\n  font-size: 12px;\r\n}\r\n\r\n.owner-menu-item {\r\n  width: 100%;\r\n  display: block;\r\n  text-align: left;\r\n  padding: 12px 10px;\r\n  border-radius: 12px;\r\n  background: transparent;\r\n  color: var(--text);\r\n}\r\n\r\n.owner-menu-item:hover {\r\n  background: var(--card-soft);\r\n}\r\n\r\n.owner-menu-item.danger {\n  color: var(--danger);\n}\n\n.shell-nav-toggle,\n.sidebar-mobile-close {\n  display: none;\n  align-items: center;\n  justify-content: center;\n  width: 42px;\n  height: 42px;\n  border-radius: 14px;\n  border: 1px solid var(--border);\n  background: rgba(255, 255, 255, 0.9);\n  color: var(--text);\n  box-shadow: var(--shadow-xs);\n  transition: transform 0