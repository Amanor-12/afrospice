n}\r\n\r\n.assistant-action-banner-copy p {\r\n  margin: 0;\r\n  color: var(--muted);\r\n  line-height: 1.55;\r\n}\r\n\r\n.error-text {\r\n  margin: 0 0 10px;\r\n  color: var(--danger);\r\n  font-weight: 600;\r\n}\r\n\r\n.empty-state-card {\r\n  padding: 24px;\r\n  border-radius: 18px;\r\n  border: 1px dashed var(--border-strong);\r\n  background: var(--card-soft);\r\n}\r\n\r\n.empty-state-card.center {\r\n  text-align: center;\r\n}\r\n\r\n/* ========================================\r\n   pos.css\r\n   ======================================== */\r\n\r\n/* =========================\r\n   POS\r\n   ========================= */\r\n\r\n.pos-toolbar-clean {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) 220px;\r\n  gap: 12px;\r\n  margin-bottom: 18px;\r\n}\r\n\r\n.pos-toolbar-single {\r\n  align-items: center;\r\n}\r\n\r\n.pos-smart-search {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  gap: 12px;\r\n}\r\n\r\n.pos-scan-input {\r\n  min-height: 54px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n.pos-catalog-scroll {\r\n  max-height: 620px;\r\n  overflow-y: auto;\r\n  padding-right: 4px;\r\n}\r\n\r\n.pos-catalog-scroll::-webkit-scrollbar,\r\n.pos-cart-scroll::-webkit-scrollbar {\r\n  width: 10px;\r\n}\r\n\r\n.pos-catalog-scroll::-webkit-scrollbar-thumb,\r\n.pos-cart-scroll::-webkit-scrollbar-thumb {\r\n  background: rgba(148, 163, 184, 0.35);\r\n  border-radius: 999px;\r\n}\r\n\r\n.pos-catalog-grid-clean {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n\r\n.pos-product-card-clean {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  text-align: left;\r\n  min-height: 210px;\r\n  padding: 18px;\r\n  border-radius: 20px;\r\n  border: 1px solid var(--border);\r\n  background:\r\n    linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.96)),\r\n    var(--card-soft);\r\n  color: var(--text);\r\n  transition: transform 0.2s ease