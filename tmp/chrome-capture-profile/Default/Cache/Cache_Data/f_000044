\n  font-size: 34px;\r\n  letter-spacing: -0.03em;\r\n}\r\n\r\n.receipt-header p {\r\n  margin: 5px 0;\r\n  color: var(--muted);\r\n  font-size: 14px;\r\n}\r\n\r\n.receipt-items,\r\n.receipt-summary {\r\n  display: grid;\r\n  gap: 10px;\r\n  margin-top: 18px;\r\n}\r\n\r\n.receipt-row {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 6px 0;\r\n  font-size: 15px;\r\n}\r\n\r\n.receipt-row.total {\r\n  padding-top: 14px;\r\n  border-top: 1px solid var(--border);\r\n  font-size: 20px;\r\n}\r\n\r\n.receipt-footer {\r\n  margin-top: 22px;\r\n  text-align: center;\r\n  color: var(--muted);\r\n  font-size: 14px;\r\n}\r\n\r\n/* ========================================\r\n   auth.css\r\n   ======================================== */\r\n\r\n/* =========================\r\n   LOGIN\r\n   ========================= */\r\n\r\n.login-screen {\r\n  min-height: 100vh;\r\n  display: grid;\r\n  place-items: center;\r\n  padding: 24px;\r\n  background:\r\n    radial-gradient(circle at top left, rgba(37, 99, 235, 0.16), transparent 28%),\r\n    radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.12), transparent 24%),\r\n    var(--bg);\r\n}\r\n\r\n.login-panel {\r\n  width: 100%;\r\n  max-width: 560px;\r\n  padding: 30px;\r\n}\r\n\r\n.login-topbar {\r\n  display: flex;\r\n  justify-content: flex-start;\r\n  align-items: center;\r\n}\r\n\r\n.login-content h2 {\r\n  margin: 18px 0 8px;\r\n  font-size: 28px;\r\n}\r\n\r\n.login-content p {\r\n  color: var(--muted);\r\n  line-height: 1.7;\r\n}\r\n\r\n.auth-form {\r\n  margin-top: 22px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n\r\n.field-label {\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: var(--muted);\r\n}\r\n\r\n.owner-login-panel {\r\n  max-width: 620px;\r\n}\r\n\r\n.login-hint-box {\r\n  margin-top: 18px;\r\n  padding: 14px 16px;\r\n  border-radius: 14px;\r\n  border: 1px solid var(--border);\r\n  background: var(--card-soft);\r\n}\r\n\r\n.login-hint-box strong {\r\n  display: block;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.login-hint-box p {\r\n  margin: 0;\r\n  color: var(--muted);\r\n  font-size: 13px;\r\n}\r\n\r\n/* ========================================\r\n   settings-controls.css\r\n   ======================================== */\r\n\r\n/* =========================\r\n   CONTROLS\r\n   ========================= */\r\n\r\n.segmented-control {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.compact-segments {\r\n  justify-content: flex-end;\r\n}\r\n\r\n.segment-btn {\r\n  min-height: 40px;\r\n  padding: 9px 15px;\r\n  border-radius: 999px;\r\n  border: 1px solid var(--border);\r\n  background: var(--card-strong);\r\n  color: var(--muted);\r\n  font-weight: 700;\r\n  transition: all 0.2s ease;\r\n  text-transform: capitalize;\r\n}\r\n\r\n.segment-btn.active {\r\n  background: linear-gradient(135deg, var(--primary), var(--primary-dark));\r\n  color: #fff;\r\n  border-color: transparent;\r\n  box-shadow: 0 14px 30px rgba(37, 99, 235, 0.22);\r\n}\r\n\r\n/* ========================================\n   analytics-pages.css\n   ======================================== */\n\r\n/* =========================\r\n   REPORTS\r\n   ========================= */\r\n\r\n.reports-hero-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.orders-hero-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n}\n\r\n/* ========================================\r\n   inventory.css\r\n   ======================================== */\r\n\r\n/* =========================\r\n   INVENTORY\r\n   ========================= */\r\n\r\n.inventory-hero-panel {\r\n  grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.95fr);\r\n  align-items: stretch;\r\n  background:\r\n    radial-gradient(circle at top right, rgba(217, 119, 6, 0.08), transparent 26%),\r\n    radial-gradient(circle at bottom left, rgba(37, 99, 235, 0.08), transparent 20%),\r\n    line