eight: 100%;\r\n  font-family: Inter, \"Segoe UI\", Arial, sans-serif;\r\n  background:\r\n    radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 24%),\r\n    radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.05), transparent 22%),\r\n    var(--bg);\r\n  color: var(--text);\r\n}\r\n\r\nbody {\r\n  color: var(--text);\r\n}\r\n\r\na {\r\n  color: inherit;\r\n  text-decoration: none;\r\n}\r\n\r\nbutton,\r\ninput,\r\nselect,\r\ntextarea {\r\n  font: inherit;\r\n}\r\n\r\nbutton {\r\n  border: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.app-shell {\r\n  min-height: 100vh;\r\n  background: transparent;\r\n}\r\n\r\n/* ========================================\r\n   shell.css\r\n   ======================================== */\r\n\r\n/* =========================\r\n   LAYOUT\r\n   ========================= */\r\n\r\n.workspace-shell {\r\n  min-height: 100vh;\r\n  display: grid;\r\n  grid-template-columns: 280px 1fr;\r\n}\r\n\r\n.workspace-main {\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.page-shell {\r\n  max-width: var(--container);\r\n  width: 100%;\r\n  margin: 0 auto;\r\n  padding: 28px;\r\n}\r\n\r\n.page-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 24px;\r\n}\r\n\r\n/* =========================\r\n   SIDEBAR\r\n   ========================= */\r\n\r\n.sidebar-shell {\r\n  position: sticky;\r\n  top: 0;\r\n  height: 100vh;\r\n  padding: 24px 18px;\r\n  background:\r\n    linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0)),\r\n    linear-gradient(180deg, var(--sidebar), var(--sidebar-soft));\r\n  border-right: 1px solid rgba(255, 255, 255, 0.04);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 26px;\r\n  box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.03);\r\n}\r\n\r\n.sidebar-brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 8px 10px 14px;\r\n}\r\n\r\n.brand-logo {\r\n  width: 46px;\r\n  height: 46px;\r\n  border-radius: 16px;\r\n  display: grid;\r\n  place-items: center;\r\n  background: linear-gradient(135deg, #2563eb, #06b6d4);\r\n  color: #fff;\r\n  font-weight: 800;\r\n  font-size: 18px;\r\n  box-shadow: 0 14px 28px rgba(37, 99, 235, 0.28);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.brand-title {\r\n  margin: 0;\r\n  font-size: 17px;\r\n  line-height: 1.1;\r\n  color: #fff;\r\n}\r\n\r\n.brand-subtitle {\r\n  margin: 4px 0 0;\r\n  font-size: 12px;\r\n  color: rgba(255, 255, 255, 0.62);\r\n}\r\n\r\n.sidebar-nav {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.sidebar-nav a,\r\n.sidebar-link {\r\n  display: block;\r\n  padding: 13px 14px;\r\n  border-radius: 14px;\r\n  color: rgba(255, 255, 255, 0.76);\r\n  font-weight: 600;\r\n  letter-spacing: -0.01em;\r\n  transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease;\r\n}\r\n\r\n.sidebar-nav a:hover,\r\n.sidebar-link:hover {\r\n  background: rgba(255, 255, 255, 0.06);\r\n  color: #fff;\r\n  transform: translateX(2px);\r\n}\r\n\r\n.sidebar-nav a.active,\r\n.sidebar-link.active {\r\n  background: linear-gradient(135deg, rgba(37, 99, 235, 0.22), rgba(6, 182, 212, 0.1));\r\n  color: #fff;\r\n  box-shadow:\r\n    inset 0 0 0 1px rgba(96, 165, 250, 0.18),\r\n    0 10px 24px rgba(0, 0, 0, 0.14);\r\n}\r\n\r\n.sidebar-footer {\r\n  margin-top: auto;\r\n}\r\n\r\n.sidebar-store-card {\r\n  padding: 16px;\r\n  border-radius: 18px;\r\n  background: rgba(255, 255, 255, 0.05);\r\n  border: 1px solid rgba(255, 255, 255, 0.07);\r\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);\r\n  color: #fff;\r\n}\r\n\r\n.sidebar-store-card span,\r\n.sidebar-store-card small {\r\n  display: block;\r\n  color: rgba(255, 255, 255, 0.64);\r\n}\r\n\r\n.sidebar-store-card span {\r\n  font-size: 12px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.sidebar-store-card strong {\r\n  display: block;\r\n  font-size: 16px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n/* =========================\r\n   TOPBAR\r\n   ========================= */\r\n\r\n.workspace-topbar {\r