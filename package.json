{
  "name": "afrospice-workspace",
  "private": true,
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node ./scripts/dev-workspace.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "db:setup-local-replica": "npm --prefix backend run db:setup-local-replica",
    "db:bootstrap": "npm --prefix backend run db:bootstrap",
    "db:reseed-reference": "npm --prefix backend run db:reseed-reference",
    "db:import-history": "node ./backend/scripts/import-historical-data.js",
    "db:cleanup-runtime": "npm --prefix backend run db:cleanup-runtime",
    "db:migrate-dates": "npm --prefix backend run db:migrate-dates",
    "assets:optimize": "npm --prefix frontend run assets:optimize",
    "cleanup:frontend": "node ./scripts/cleanup-frontend-artifacts.cjs",
    "verify:frontend:budgets": "node ./scripts/verify-frontend-budgets.cjs",
    "verify:runtime": "npm --prefix backend run verify:runtime",
    "verify:data-quality": "npm --prefix backend run verify:data-quality",
    "verify:transactions": "npm --prefix backend run verify:transactions",
    "verify:readiness": "npm --prefix backend run verify:readiness",
    "verify:owner": "npm --prefix backend run verify:owner",
    "verify:owner:e2e": "npm --prefix backend run verify:owner:e2e",
    "verify:backup": "npm --prefix backend run verify:backup",
    "verify:restore": "npm --prefix backend run verify:restore",
    "verify:browser:e2e": "node ./scripts/run-playwright-e2e.cjs",
    "verify:load:smoke": "node ./scripts/load-smoke.cjs",
    "verify:load:proof": "node ./scripts/load-proof.cjs",
    "qa:recruiter:gifs": "python ./scripts/generate_recruiter_gifs.py",
    "deploy:render:target": "node ./scripts/render-deploy-target.cjs",
    "verify:release": "node ./scripts/verify-release.cjs",
    "verify:release:local": "node ./scripts/verify-release.cjs --allow-readiness-warnings"
  },
  "dependencies": {
    "mongoose": "^9.3.3"
  }
}
